{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "KeePassXC",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/KeePassXC.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/src",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/build/src;${workspaceFolder}/../vcpkg/installed/x64-windows/debug/bin;${env:PATH}"
                },
                {
                    "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
                    "value": "${workspaceFolder}/../vcpkg/installed/x64-windows/debug/Qt6/plugins/platforms"
                }
            ],
            "console": "externalConsole"
        }
    ]
}
